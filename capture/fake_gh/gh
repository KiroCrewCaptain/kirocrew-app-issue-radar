#!/usr/bin/env python3
"""A stand-in `gh` for the README capture, serving fictional GitHub data.

The capture never connects a real repository: the isolated gateway is pointed at
this script (`KIROCREW_GH_BIN`), which answers `gh api <path>` from the fictional
repository in `repo.json` beside it, applying `--jq` with the system `jq` the
way `gh` applies its own. A write is answered as accepted and changes nothing.
Every call is appended to `calls.log` (in the capture's scratch directory when
`FAKE_GH_LOG` is set, else beside this file) so a scene that needs a route the
fixture lacks is easy to find. Nothing here talks to a network.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import parse_qs, urlsplit

HERE = Path(__file__).resolve().parent
DATA = json.loads((HERE / "repo.json").read_text(encoding="utf-8"))
LOG = Path(os.environ.get("FAKE_GH_LOG") or HERE / "calls.log")


def log(line: str) -> None:
    try:
        with LOG.open("a", encoding="utf-8") as fh:
            fh.write(line + "\n")
    except OSError:
        pass


def fail(message: str, code: int = 1) -> None:
    sys.stderr.write(f"gh: {message}\n")
    sys.exit(code)


def emit(payload, jq_expr):
    if jq_expr is None:
        sys.stdout.write(json.dumps(payload) + "\n")
        return
    proc = subprocess.run(
        ["jq", "-r", "-c", jq_expr],
        input=json.dumps(payload),
        capture_output=True,
        text=True,
        encoding="utf-8",
    )
    if proc.returncode != 0:
        fail(f"jq failed: {proc.stderr.strip()}")
    sys.stdout.write(proc.stdout)


def lookup(path: str):
    parts = urlsplit(path)
    key = parts.path.strip("/")
    query = parse_qs(parts.query)
    routes = DATA["routes"]
    if key in routes:
        value = routes[key]
        if isinstance(value, dict) and "_by_query" in value:
            for qkey, qval in value["_by_query"].items():
                name, _, want = qkey.partition("=")
                if want in query.get(name, [""])[0]:
                    return qval
            return value.get("_default")
        return value
    for pattern, value in DATA.get("patterns", {}).items():
        if re.fullmatch(pattern, key):
            return value
    return None


def view(kind: str, number: str, comments: bool) -> None:
    """`gh issue view N` / `gh pr view N`: the item as `gh` prints it for a terminal."""
    base = f"repos/{DATA['owner']}/{DATA['repo']}"
    item = lookup(f"{base}/issues/{number}")
    if item is None:
        fail(f"Could not resolve to an issue or pull request with the number of {number}.")
    labels = ", ".join(lbl["name"] for lbl in item.get("labels", []))
    out = [
        f"{item['title']} {DATA['owner']}/{DATA['repo']}#{number}",
        f"{item['state'].capitalize()} • {item['user']['login']} opened • {item.get('comments', 0)} comments",
        f"Labels: {labels}" if labels else "",
        "",
        item.get("body") or "",
        "",
    ]
    if comments:
        for event in lookup(f"{base}/issues/{number}/timeline") or []:
            if event.get("event") == "commented":
                out += [f"{event['user']['login']} • {event['created_at']}", event["body"], ""]
    sys.stdout.write("\n".join(out) + "\n")


def main(argv):
    log(json.dumps(argv[1:]))
    if not argv[1:] or argv[1] in ("--version", "version"):
        sys.stdout.write("gh version 2.80.0 (fake for the README capture)\n")
        return
    if argv[1] == "auth":
        sys.stdout.write("github.com\n  Logged in to github.com account maya-example (fixture)\n")
        return
    if argv[1] in ("issue", "pr") and len(argv) > 3 and argv[2] == "view":
        view(argv[1], argv[3], "--comments" in argv)
        return
    if argv[1] != "api":
        fail(f"'{' '.join(argv[1:3])}' is not available in the capture's fake gh")
    args = argv[2:]
    jq_expr = None
    method = "GET"
    path = None
    fields = {}
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--jq", "-q"):
            jq_expr = args[i + 1]
            i += 2
        elif a in ("-X", "--method"):
            method = args[i + 1].upper()
            i += 2
        elif a in ("-f", "-F", "--raw-field", "--field"):
            k, _, v = args[i + 1].partition("=")
            fields[k] = v
            i += 2
        elif a in ("-H", "--header", "--hostname", "--input", "--cache"):
            i += 2
        elif a.startswith("-"):
            i += 1
        else:
            if path is None:
                path = a
            i += 1
    if path is None:
        fail("no path")
    if path == "graphql":
        query = fields.get("query", "")
        for marker, payload in DATA.get("graphql", {}).items():
            if marker in query:
                emit(payload, jq_expr)
                return
        emit({"data": {}}, jq_expr)
        return
    if method != "GET" and (fields or "--input" in args):
        method = method if method != "GET" else "POST"
    if method != "GET":
        payload = lookup(f"WRITE {path}") or {"ok": True}
        emit(payload, jq_expr)
        return
    payload = lookup(path)
    if payload is None:
        fail(f"HTTP 404: Not Found ({path})", 1)
    emit(payload, jq_expr)


if __name__ == "__main__":
    main(sys.argv)
